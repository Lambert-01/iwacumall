<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#081F62"
                android:centerColor="#1455D9"
                android:endColor="#0A2B78"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="176dp"
        android:height="176dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/iwacumall_launch_logo" />
    </item>
</layer-list>
