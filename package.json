{
  "name": "iwacumall-fullstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IwacuMall e-commerce website, Node.js API, MongoDB Atlas, and Flutter Android client",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --watch --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate-sqlite-to-mongo.mjs",
    "migrate:write": "node --env-file-if-exists=.env scripts/migrate-sqlite-to-mongo.mjs --write"
  },
  "dependencies": {
    "google-auth-library": "^10.9.1",
    "mongodb": "^6.17.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4"
  }
}
