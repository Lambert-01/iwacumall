# Copy to .env and fill in real values. Never commit the real .env file.
# See docs/DEPLOYMENT.md for descriptions of each variable.

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Required in production. Obtain from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=iwacumall

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=REPLACE_WITH_DIFFERENT_32_CHAR_SECRET
SESSION_TTL_SECONDS=604800

# ─── Store information ────────────────────────────────────────────────────────
STORE_NAME=IwacuMall
# OWNER: Replace with your confirmed store address
STORE_ADDRESS=Downtown Kigali
# OWNER: Replace with your confirmed store phone
STORE_PHONE=+250788651421
STORE_EMAIL=
# Dedicated recipient for new order and invoice email copies.
STORE_NOTIFICATION_EMAIL=orders@your-domain.example
CURRENCY=RWF

# ─── Admin account ────────────────────────────────────────────────────────────
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD_14CHARS_MIN
ADMIN_NAME=IwacuMall Administrator

# ─── Invoice and payment ──────────────────────────────────────────────────────
# OWNER: Set the number of hours a customer has to pay after placing an order.
# If not set (or 0), invoice checkout is disabled.
INVOICE_EXPIRY_HOURS=REPLACE_WITH_YOUR_PAYMENT_DEADLINE_HOURS

# OWNER: Flat delivery fee in RWF (0 = free delivery).
# If not set, checkout is blocked until you configure this.
DELIVERY_FEE_FLAT=REPLACE_WITH_YOUR_DELIVERY_FEE_RWF

# OWNER: Tax/VAT rate percent (e.g. 18 for 18%). Leave negative or unset if
# no tax applies. Only add when you have confirmed your tax obligations.
TAX_RATE_PERCENT=-1

# ─── Email (optional — orders still save if email fails) ─────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=noreply@yourdomain.com
# Set this to the real public HTTPS website before using email flows:
APP_BASE_URL=https://YOUR_DOMAIN

# ─── Google Sign-In ───────────────────────────────────────────────────────────
# Web OAuth client ID. It is public; never put a client secret in browser/mobile code.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Allowed ID-token audiences; use the Web client ID used as Android serverClientId.
GOOGLE_CLIENT_IDS=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# ─── Durable product image uploads (Cloudinary) ───────────────────────────────
# Leave all three blank to disable uploads; use HTTPS image URLs in that case.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email verification ────────────────────────────────────────────────────────
# Set to true to require email verification before a customer can order.
EMAIL_VERIFICATION_REQUIRED=false
# Production must set EMAIL_VERIFICATION_REQUIRED=true and configure real SMTP details.

# ─── CORS (only needed if web is on a separate domain) ────────────────────────
CORS_ORIGINS=

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Number of reverse proxy hops in front of the app (1 for a single Nginx).
TRUST_PROXY_HOPS=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LOGIN=10
RATE_LIMIT_MAX_REGISTER=5
RATE_LIMIT_MAX_RESET=5

# ─── Demo catalog ─────────────────────────────────────────────────────────────
# Set to false in production after loading your real products.
SEED_DEMO_CATALOG=true
