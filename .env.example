# Copy to .env and edit before running. Do not commit real secrets.
PORT=4000
HOST=127.0.0.1
DATABASE_PATH=./data/iwacumall.sqlite
STORE_NAME=IwacuMall
STORE_ADDRESS=Downtown Kigali
STORE_PHONE=0788651421
# Set both to seed the first admin. Make the password unique (12+ chars).
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
ADMIN_NAME=IwacuMall Administrator
# Optional other web origins, separated by commas, if web is hosted separately:
CORS_ORIGINS=

# Set to false in production after loading real products; demo data is for previews only.
SEED_DEMO_CATALOG=true
